# Origin used for WebAuthn and for links. HTTPS is required, except http://localhost for web dev.
PUBLIC_URL=http://localhost:3000
# WebAuthn relying party. Must be the registrable domain of PUBLIC_URL (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Saldo
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
JWT_SECRET=
DATABASE_URL=postgres://saldo:saldo@localhost:5432/saldo

# Attachment storage (§10). `none` keeps attachments on the phone: they are still captured and
# their rows still sync, but the bytes never leave the device.
# none | fs | s3 | vercel-blob
ATTACHMENT_STORAGE=none
# fs
# STORAGE_DIR=./.data/attachments
# s3 — also R2, MinIO, Backblaze and Hetzner, through S3_ENDPOINT.
# These values are the ones the local development stack serves (Floci, see
# apps/web/docker/docker-compose.dev.yml); a real bucket replaces them wholesale.
# ATTACHMENT_STORAGE=s3
# S3_BUCKET=saldo-attachments
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:4566
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_FORCE_PATH_STYLE=true
# vercel-blob (Vercel injects this one for you)
# BLOB_READ_WRITE_TOKEN=
# open | first-user (only while no user exists) | closed
REGISTRATION=first-user
# Comma-separated custom URL schemes accepted as a mobile redirect target.
APP_REDIRECT_SCHEMES=saldo
