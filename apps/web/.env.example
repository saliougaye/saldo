# Origin used for WebAuthn and for links. HTTPS is required, except http://localhost for web dev.
PUBLIC_URL=http://localhost:3000
# WebAuthn relying party. Must be the registrable domain of PUBLIC_URL (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Saldo
# 32+ random bytes, base64. Generate with: openssl rand -base64 48
JWT_SECRET=
DATABASE_URL=postgres://saldo:saldo@localhost:5432/saldo
# Encrypts the secrets the admin panel stores (the SMTP password). Exactly 32 random bytes, base64.
# Generate with: openssl rand -base64 32
# Keep it: lose it and the stored SMTP password must be entered again; nothing else depends on it.
SETTINGS_ENCRYPTION_KEY=

# Attachment storage (§10). `none` keeps attachments on the phone: they are still captured and
# their rows still sync, but the bytes never leave the device.
# none | fs | s3 | vercel-blob
ATTACHMENT_STORAGE=none
# fs
# STORAGE_DIR=./.data/attachments
# s3 — also R2, MinIO, Backblaze and Hetzner, through S3_ENDPOINT.
# These values are the ones the local development stack serves (Floci, see
# apps/web/docker/docker-compose.dev.yml); a real bucket replaces them wholesale.
# ATTACHMENT_STORAGE=s3
# S3_BUCKET=saldo-attachments
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:4566
# S3_ACCESS_KEY_ID=test
# S3_SECRET_ACCESS_KEY=test
# S3_FORCE_PATH_STYLE=true
# vercel-blob (Vercel injects this one for you)
# BLOB_READ_WRITE_TOKEN=
# open | first-user (only while no user exists) | closed | invite
# `invite` is the one to use: nothing creates an account without a single-use code, yours
# included. Mint the first one on the server with `pnpm --filter web invite new`.
# Optional: set, it wins over the admin panel and locks that setting; unset, the panel chooses
# (`first-user` until it does).
REGISTRATION=invite
# Optional, 1-60 characters: the name the sign-in page and invites show. Set, it locks the panel's
# field; unset, the panel's value, then WEBAUTHN_RP_NAME.
# INSTANCE_NAME=

# Optional outgoing email. Set SMTP_HOST and this whole group is the configuration and the admin
# panel's SMTP form is locked; leave it all unset and configure it in the panel instead.
# SMTP_FROM is then required; SMTP_USER and SMTP_PASSWORD come together or not at all.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Saldo <saldo@example.com>
# Comma-separated custom URL schemes accepted as a mobile redirect target.
APP_REDIRECT_SCHEMES=saldo

# Comma-separated IPs/CIDRs of the reverse proxy(ies) in front of this server (e.g. Caddy). Needed
# for auth rate limiting to key on the real caller: Caddy's `reverse_proxy` *appends* to
# `X-Forwarded-For` rather than replacing it, so a caller who sends its own copy of that header
# leaves two addresses in it, and Better Auth then resolves no IP at all and falls back to one
# bucket shared by every caller — on /sign-in that's 3 requests per 10s for the whole server, so
# one attacker can lock everyone out. Leave empty only when nothing sits in front of this server
# (e.g. local development). Wrong in the other direction is just as bad: too broad a range (a public
# CIDR, or anything that could match a real client's address) lets a caller's *own* forged
# `X-Forwarded-For` entry be trusted as the resolved IP, which both defeats the rate limit (rotate
# the header, get a fresh bucket every request) and lets them frame another address for it. Use the
# proxy's actual address or the docker network's subnet, never 0.0.0.0/0 or a whole private range.
# See docs/self-hosting.md and docker/Caddyfile.example.
TRUSTED_PROXIES=

# The time zone used for a user whose settings carry none yet (every phone fills its own). An IANA
# name such as Europe/Rome. Not TZ: Vercel reserves that name.
# DEFAULT_TIME_ZONE=UTC
