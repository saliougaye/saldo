{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "invite": "tsx --env-file-if-exists=.env scripts/invite.ts",
    "user": "tsx --env-file-if-exists=.env scripts/user.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "measure:panel": "tsx --env-file-if-exists=.env scripts/measure-panel.ts",
    "measure:nav": "tsx --env-file-if-exists=.env scripts/measure-nav.ts",
    "build:migrate": "esbuild src/server/db/migrate.ts --bundle --platform=node --format=cjs --outfile=migrate.cjs --external:pg-native --log-level=error",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@base-ui/react": "^1.9.0",
    "@better-auth/expo": "^1.7.14",
    "@better-auth/oauth-provider": "^1.7.14",
    "@better-auth/passkey": "^1.7.14",
    "@better-auth/utils": "0.5.1",
    "@modelcontextprotocol/server": "^2.4.0",
    "@saldo/core": "workspace:*",
    "@saldo/i18n": "workspace:*",
    "@saldo/ui": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.0",
    "jose": "^6.2.14",
    "next": "^16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
