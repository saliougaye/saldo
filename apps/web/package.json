{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "invite": "tsx --env-file-if-exists=.env scripts/invite.ts",
    "user": "tsx --env-file-if-exists=.env scripts/user.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "measure:panel": "tsx --env-file-if-exists=.env scripts/measure-panel.ts",
    "build:migrate": "esbuild src/server/db/migrate.ts --bundle --platform=node --format=cjs --outfile=migrate.cjs --external:pg-native --log-level=error"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@base-ui/react": "^1.8.0",
    "@better-auth/expo": "^1.7.7",
    "@better-auth/oauth-provider": "^1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@better-auth/utils": "0.4.2",
    "@modelcontextprotocol/server": "^2.3.0",
    "@saldo/core": "workspace:*",
    "@saldo/i18n": "workspace:*",
    "@saldo/ui": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.1",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "jose": "^6.2.12",
    "next": "^16.3.4",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/client": "^2.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.18",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
