---
/**
 * Spec 0.8b §06 (D57): replaces Starlight's provider. It reads the key of the landing page,
 * `saldo-site-theme`, before the first paint. Starlight needs `data-theme` to be `light` or `dark`,
 * so «System» resolves to one of the two. `data-theme-choice` keeps the choice for the toggle icon.
 */
---

<script is:inline>
  // Plain inline script, no module: a module runs after the first paint, and the page flashes.
  (() => {
    let choice = null;
    try {
      choice = localStorage.getItem('saldo-site-theme');
    } catch {}
    if (choice !== 'light' && choice !== 'dark') choice = 'system';
    const system = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    document.documentElement.dataset.theme = choice === 'system' ? system : choice;
    document.documentElement.dataset.themeChoice = choice;
  })();
</script>
