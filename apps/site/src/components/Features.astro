---
import type { SiteContent } from '../content/index';
import BudgetsMock from './mocks/BudgetsMock.astro';
import ExportMock from './mocks/ExportMock.astro';
import ForecastMock from './mocks/ForecastMock.astro';
import GoalMock from './mocks/GoalMock.astro';
import ImportMock from './mocks/ImportMock.astro';
import PeriodsMock from './mocks/PeriodsMock.astro';
import RecurringMock from './mocks/RecurringMock.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const f = content.features;
---

<section class="sec bordered" id="features">
  <div class="wrap">
    <div class="sec-head"><p class="eyebrow">{f.eyebrow}</p><h2 class="h2">{f.title}</h2><p class="lede">{f.lede}</p></div>
    <div class="bento">
      <article class="cell span2"><div class="split"><div class="copy-b"><h3 class="h3">{f.budgets.title}</h3><p class="p">{f.budgets.body}</p></div><div class="mockbox"><BudgetsMock content={content} /></div></div></article>
      <article class="cell"><div class="copy-b"><h3 class="h3">{f.goals.title}</h3><p class="p">{f.goals.body}</p></div><div class="mockbox"><GoalMock content={content} /></div></article>
      <article class="cell"><div class="copy-b"><h3 class="h3">{f.forecast.title}</h3><p class="p">{f.forecast.body}</p></div><div class="mockbox"><ForecastMock content={content} /></div></article>
      <article class="cell"><div class="copy-b"><h3 class="h3">{f.recurring.title}</h3><p class="p">{f.recurring.body}</p></div><div class="mockbox"><RecurringMock content={content} /></div></article>
      <article class="cell"><div class="copy-b"><h3 class="h3">{f.periods.title}</h3><p class="p">{f.periods.body}</p></div><div class="mockbox"><PeriodsMock content={content} /></div></article>
      <article class="cell span2"><div class="split"><div class="copy-b"><h3 class="h3">{f.import.title}</h3><p class="p">{f.import.body}</p></div><div class="mockbox"><ImportMock content={content} /></div></div></article>
      <article class="cell"><div class="copy-b"><h3 class="h3">{f.export.title}</h3><p class="p">{f.export.body}</p></div><div class="mockbox"><ExportMock content={content} /></div></article>
    </div>
  </div>
</section>
