---
import type { SiteContent } from '../../../content/index';
import { appCount, appText } from '../../../lib/appText';
import { moneyText } from '../../../lib/format';
import { budgetStates, periodDay } from '../../../lib/sample';
import Amount from '../../Amount.astro';
import Bar from '../Bar.astro';
import Mib from '../Mib.astro';
import TitleHead from '../TitleHead.astro';

interface Props {
  content: SiteContent;
}

const { content } = Astro.props;
const { sample, locale, currency } = content;
const { pace, daysLeft } = periodDay(sample);
---

<div class="pc">
  <TitleHead title={appText(locale, 'budgets.title')} back add />
  {budgetStates(sample).map((budget) => {
    const category = sample.categories[budget.category];
    return (
      <div class="mc">
        <div class="brow-m">
          <Mib icon={category.icon} color={category.color} />
          <div class="grow"><div>{category.name}</div><div class="ml">{appCount(locale, 'budgets.daysLeft', daysLeft)}</div></div>
          <div class="end"><div class="strong"><Amount class="ma" minor={budget.spent} currency={currency} locale={locale} /></div><div class="ml">{appText(locale, 'budgets.ofLimit', { amount: moneyText(content, budget.limit) })}</div></div>
        </div>
        <div style="margin-top:14px"><Bar ratio={budget.ratio} pace={pace} over={budget.overPace} /></div>
      </div>
    );
  })}
</div>
